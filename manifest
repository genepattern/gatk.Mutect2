# GenePattern Module Manifest

LSID=urn:lsid:broad.mit.edu:cancer.software.genepattern.module.generated:49498:1
name=Mutect2
version=1.0.0
author=GenePattern Team
description=Calls somatic short variants (SNVs and indels) from tumor DNA sequencing data using local haplotype assembly and a Bayesian somatic genotyping engine. Supports tumor-normal paired mode and tumor-only mode. Automatically checks for and generates required companion index files (.bai, .tbi, .fai, .dict). Optionally runs integrated post-processing steps including FilterMutectCalls and LearnReadOrientationModel for FFPE/NovaSeq samples.
categories=SNPAnalysis;VariantCalling;Somatic
commandLine=bash <libdir>mutect2_wrapper.sh <tumor.bam> <normal.bam> <reference> <germline.resource> <panel.of.normals> <intervals> <tumor.sample.name> <normal.sample.name> <output.prefix> <run.filter> <run.orientation.bias.filter> <java.heap.size> <pairhmm.threads> <max.reads.per.alignment.start> <initial.tumor.lod> <tumor.lod.to.emit> <normal.lod> <af.of.alleles.not.in.resource> <mitochondria.mode> <pcr.indel.model> <max.mnp.distance> <base.quality.score.threshold> <dont.use.soft.clipped.bases> <genotype.germline.sites> <genotype.pon.sites>
cpuType=any
os=any
language=Java
taskType=VariantCalling
documentationUrl=https://gatk.broadinstitute.org/hc/en-us/articles/360037593851-Mutect2
quality=production
privacy=public
job.cpuCount=8
job.memory=16Gb
job.docker.image=broadinstitute/gatk\:4.6.2.0
src.repo=https://github.com/broadinstitute/gatk

# Parameters
p1_MODE=IN
p1_TYPE=FILE
p1_description=Sorted tumor BAM, SAM, or CRAM file. Must contain a read group (@RG) with SM: tag. A companion .bai index is required -- if absent, the wrapper will automatically generate it using gatk BuildBamIndex.
p1_fileFormat=bam;sam;cram
p1_name=tumor.bam
p1_numValues=1..1
p1_optional=
p1_prefix_when_specified=--tumor.bam 
p1_type=java.io.File
p2_MODE=IN
p2_TYPE=FILE
p2_description=Sorted matched normal BAM, SAM, or CRAM file. Required for tumor-normal mode; leave empty for tumor-only mode. Must contain a read group (@RG) with SM: tag. A companion .bai index is required -- if absent, the wrapper will automatically generate it using gatk BuildBamIndex.
p2_fileFormat=bam;sam;cram
p2_name=normal.bam
p2_numValues=0..1
p2_optional=on
p2_prefix_when_specified=--normal.bam 
p2_type=java.io.File
p3_MODE=IN
p3_TYPE=FILE
p3_description=Reference genome FASTA file (.fa or .fasta). Companion .fai (samtools faidx) and .dict (Picard CreateSequenceDictionary) files are required -- if absent, the wrapper will automatically generate them.
p3_fileFormat=fa;fasta
p3_name=reference
p3_numValues=1..1
p3_optional=
p3_prefix_when_specified=--reference 
p3_type=java.io.File
p4_MODE=IN
p4_TYPE=FILE
p4_description=Population allele frequency VCF.gz for germline variant priors. The Broad Institute recommends af-only-gnomad.hg38.vcf.gz. Must contain an AF (allele frequency) field. A companion .tbi index is required -- if absent, the wrapper will automatically generate it using gatk IndexFeatureFile.
p4_fileFormat=vcf.gz;vcf
p4_name=germline.resource
p4_numValues=0..1
p4_optional=on
p4_prefix_when_specified=--germline.resource 
p4_type=java.io.File
p5_MODE=IN
p5_TYPE=FILE
p5_description=Panel of Normals (PoN) VCF.gz file for filtering recurrent technical artifacts. Recommended: 1000g_pon.hg38.vcf.gz from the GATK resource bundle. A companion .tbi index is required -- if absent, the wrapper will automatically generate it using gatk IndexFeatureFile.
p5_fileFormat=vcf.gz;vcf
p5_name=panel.of.normals
p5_numValues=0..1
p5_optional=on
p5_prefix_when_specified=--panel.of.normals 
p5_type=java.io.File
p6_MODE=IN
p6_TYPE=FILE
p6_description=Genomic intervals file to restrict variant calling to specific regions. Strongly recommended for WES and targeted panels to reduce runtime. Accepts GATK-supported formats: .intervals, .list, .bed, or .interval_list.
p6_fileFormat=intervals;list;bed;interval_list
p6_name=intervals
p6_numValues=0..1
p6_optional=on
p6_prefix_when_specified=--intervals 
p6_type=java.io.File
p7_TYPE=TEXT
p7_description=Sample name (SM tag) for the tumor BAM file, as found in the @RG read group header. If left empty, the wrapper will auto-detect by parsing the BAM header using samtools. Example: HG008-T.
p7_name=tumor.sample.name
p7_numValues=0..1
p7_optional=on
p7_prefix_when_specified=--tumor.sample.name 
p7_type=java.lang.String
p8_TYPE=TEXT
p8_description=Sample name (SM tag) for the normal BAM file, as found in the @RG read group header. If left empty, the wrapper will auto-detect by parsing the BAM header using samtools. Only applicable in tumor-normal mode. Example: HG008-N-D.
p8_name=normal.sample.name
p8_numValues=0..1
p8_optional=on
p8_prefix_when_specified=--normal.sample.name 
p8_type=java.lang.String
p9_TYPE=TEXT
p9_default_value=mutect2_output
p9_description=Prefix for all output files. The module will produce {output.prefix}_unfiltered.vcf.gz and, if filtering is enabled, {output.prefix}_filtered.vcf.gz.
p9_name=output.prefix
p9_numValues=1..1
p9_optional=on
p9_prefix_when_specified=--output.prefix 
p9_type=java.lang.String
p10_TYPE=TEXT
p10_default_value=true
p10_description=Run FilterMutectCalls after variant calling to produce a filtered VCF with PASS/FAIL annotations. Recommended for most workflows. Set to false to only produce the unfiltered VCF.
p10_name=run.filter
p10_numValues=1..1
p10_optional=on
p10_prefix_when_specified=--run.filter 
p10_type=java.lang.String
p10_value=true\=true;false\=false
p11_TYPE=TEXT
p11_default_value=false
p11_description=Collect F1R2 read orientation data during Mutect2 calling and run LearnReadOrientationModel to generate orientation bias priors. Strongly recommended for FFPE samples and NovaSeq data. Produces f1r2.tar.gz and read-orientation-model.tar.gz as additional outputs.
p11_name=run.orientation.bias.filter
p11_numValues=1..1
p11_optional=on
p11_prefix_when_specified=--run.orientation.bias.filter 
p11_type=java.lang.String
p11_value=true\=true;false\=false
p12_TYPE=TEXT
p12_default_value=8g
p12_description=Maximum JVM heap size for GATK (e.g., 8g, 16g, 32g). Increase for WGS or high-depth data. Corresponds to the -Xmx JVM option.
p12_name=java.heap.size
p12_numValues=1..1
p12_optional=on
p12_prefix_when_specified=--java.heap.size 
p12_type=java.lang.String
p13_TYPE=Integer
p13_default_value=4
p13_description=Number of threads to use for the PairHMM likelihood scoring kernel, which is the most CPU-intensive step in Mutect2. Corresponds to the --native-pair-hmm-threads GATK argument.
p13_name=pairhmm.threads
p13_numValues=1..1
p13_optional=on
p13_prefix_when_specified=--pairhmm.threads 
p13_type=java.lang.Integer
p14_TYPE=Integer
p14_default_value=50
p14_description=Maximum number of reads to retain per alignment start position for downsampling. Increase to 200 or higher for amplicon sequencing or very high-depth data to avoid excessive downsampling. Corresponds to the --max-reads-per-alignment-start GATK argument.
p14_name=max.reads.per.alignment.start
p14_numValues=1..1
p14_optional=on
p14_prefix_when_specified=--max.reads.per.alignment.start 
p14_type=java.lang.Integer
p15_TYPE=Floating Point
p15_description=Minimum log10 odds score to activate variant calling in a genomic region (active region detection threshold). Default is 2.0 (standard somatic calling) or 0.0 (mitochondria mode). Corresponds to --initial-tumor-lod.
p15_name=initial.tumor.lod
p15_numValues=0..1
p15_optional=on
p15_prefix_when_specified=--initial.tumor.lod 
p15_type=java.lang.Float
p16_TYPE=Floating Point
p16_description=Minimum log10 odds score for a variant to be included in the output VCF. Default is 3.0 (standard somatic calling) or 0.0 (mitochondria mode). Lower values increase sensitivity at the cost of more false positives. Corresponds to --tumor-lod-to-emit.
p16_name=tumor.lod.to.emit
p16_numValues=0..1
p16_optional=on
p16_prefix_when_specified=--tumor.lod.to.emit 
p16_type=java.lang.Float
p17_TYPE=Floating Point
p17_description=Minimum log10 odds score to classify the normal sample as non-germline at a candidate variant site. Default is 2.2. Increase for stricter germline filtering. Corresponds to --normal-lod.
p17_name=normal.lod
p17_numValues=0..1
p17_optional=on
p17_prefix_when_specified=--normal.lod 
p17_type=java.lang.Float
p18_TYPE=Floating Point
p18_description=Prior allele fraction assumed for variants not found in the germline resource. Default depends on mode: 1e-6 for tumor-normal, 5e-8 for tumor-only, 4e-3 for mitochondria mode. Corresponds to --af-of-alleles-not-in-resource.
p18_name=af.of.alleles.not.in.resource
p18_numValues=0..1
p18_optional=on
p18_prefix_when_specified=--af.of.alleles.not.in.resource 
p18_type=java.lang.Float
p19_TYPE=TEXT
p19_default_value=false
p19_description=Enable mitochondrial variant calling mode. Sets specialized LOD thresholds optimized for the high heteroplasmy rates of the mitochondrial genome. Corresponds to --mitochondria-mode.
p19_name=mitochondria.mode
p19_numValues=1..1
p19_optional=on
p19_prefix_when_specified=--mitochondria.mode 
p19_type=java.lang.String
p19_value=false\=false;true\=true
p20_TYPE=TEXT
p20_default_value=CONSERVATIVE
p20_description=Error model for PCR slippage artifacts at indel sites. CONSERVATIVE is appropriate for most standard libraries. AGGRESSIVE reduces sensitivity but increases specificity for error-prone library preparations. NONE disables the model. Corresponds to --pcr-indel-model.
p20_name=pcr.indel.model
p20_numValues=1..1
p20_optional=on
p20_prefix_when_specified=--pcr.indel.model 
p20_type=java.lang.String
p20_value=CONSERVATIVE\=CONSERVATIVE;AGGRESSIVE\=AGGRESSIVE;HOSTILE\=HOSTILE;NONE\=NONE
p21_TYPE=Integer
p21_description=Maximum distance (in base pairs) between adjacent SNPs to be merged into a multi-nucleotide polymorphism (MNP). Set to 0 when running Mutect2 in Panel of Normals construction mode. Default is 1. Corresponds to --max-mnp-distance.
p21_name=max.mnp.distance
p21_numValues=0..1
p21_optional=on
p21_prefix_when_specified=--max.mnp.distance 
p21_type=java.lang.Integer
p22_TYPE=Integer
p22_description=Bases with a base quality score below this threshold are set to the minimum quality value and effectively excluded from analysis. Default is 18. Corresponds to --base-quality-score-threshold.
p22_name=base.quality.score.threshold
p22_numValues=0..1
p22_optional=on
p22_prefix_when_specified=--base.quality.score.threshold 
p22_type=java.lang.Integer
p23_TYPE=TEXT
p23_default_value=false
p23_description=Exclude soft-clipped bases from variant calling. Recommended when processing RNA-seq BAMs pre-processed with SplitNCigarReads to avoid artifacts at exon-intron boundaries. Corresponds to --dont-use-soft-clipped-bases.
p23_name=dont.use.soft.clipped.bases
p23_numValues=1..1
p23_optional=on
p23_prefix_when_specified=--dont.use.soft.clipped.bases 
p23_type=java.lang.String
p23_value=false\=false;true\=true
p24_TYPE=TEXT
p24_default_value=false
p24_description=Force genotyping at all sites present in the germline resource VCF, regardless of somatic evidence. Produces a more complete VCF that includes germline sites. Corresponds to --genotype-germline-sites.
p24_name=genotype.germline.sites
p24_numValues=1..1
p24_optional=on
p24_prefix_when_specified=--genotype.germline.sites 
p24_type=java.lang.String
p24_value=false\=false;true\=true
p25_TYPE=TEXT
p25_default_value=false
p25_description=Force genotyping at all sites present in the Panel of Normals VCF, even if there is no somatic evidence. Useful for diagnostic purposes to inspect PoN-flagged sites. Corresponds to --genotype-pon-sites.
p25_name=genotype.pon.sites
p25_numValues=1..1
p25_optional=on
p25_prefix_when_specified=--genotype.pon.sites 
p25_type=java.lang.String
p25_value=false\=false;true\=true

